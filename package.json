{
  "name": "dsh-plugin-license-manager",
  "version": "0.1.0",
  "description": "Gestor de licencias para DeepSeek Harness: genera, verifica y revoca claves HMAC locales para apps y bots de WENDIGO, con vencimientos y almacenamiento local.",
  "type": "module",
  "license": "MIT",
  "author": "thegabopacheco-sudo",
  "homepage": "https://github.com/thegabopacheco-sudo/dsh-plugin-license-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegabopacheco-sudo/dsh-plugin-license-manager.git"
  },
  "bugs": {
    "url": "https://github.com/thegabopacheco-sudo/dsh-plugin-license-manager/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "license-manager"
  ],
  "main": "./dist/server.mjs",
  "files": [
    "dist/",
    "docs/",
    "cordis.patch.yml",
    "scripts/postinstall.mjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:bundle": "esbuild server.mjs --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
    "prepack": "npm run build:bundle",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "esbuild": "0.28.2",
    "zod": "4.4.3"
  }
}
